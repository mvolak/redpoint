# Redcord web — environment template. Contains NO secrets. Copy to apps/redcord-web/.env.local.

# "preview" = noindex + review banners (default). "production" only after owner approval and cutover tests.
SITE_ENV=preview

# Canonical origin used for metadata/sitemap. Preview default is localhost.
SITE_ORIGIN=http://localhost:3000

# Enquiry adapter. Only "test" exists in this prototype: requests are validated and DISCARDED (never delivered).
# A production adapter (durable storage + delivery + failure reporting) is a backlog item.
ENQUIRY_ADAPTER=test

# Redpoint Clinic booking URL — must be supplied by the owner. Left empty on purpose: do not guess it.
REDPOINT_BOOKING_URL=
