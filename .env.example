# Redcord web — environment template. Contains NO secrets. Copy to apps/redcord-web/.env.local.

# "preview" = noindex + review banners (default). "production" only after owner approval and cutover tests.
SITE_ENV=preview

# Canonical origin used for metadata/sitemap. Preview default is localhost.
SITE_ORIGIN=http://localhost:3000

# Enquiry adapter. Only "test" exists in this prototype: requests are validated and DISCARDED (never delivered).
# A production adapter (durable storage + delivery + failure reporting) is a backlog item.
ENQUIRY_ADAPTER=test

# ---------------------------------------------------------------------------------------------
# Redpoint Clinic booking (packages/booking, served at /rezervace/). See docs/booking/README.md.
# Leave DATABASE_URL or APP_SECRET empty and /rezervace/ shows a "not connected" notice instead.
# The booking scripts (pnpm db:migrate / db:seed / worker) read this same file.

# Public base URL of this site (links in e-mails, Origin checks). Same value as SITE_ORIGIN.
APP_URL=http://localhost:3000
# development | staging | production  (staging/production refuse dev-only providers)
APP_ENV=development
CLINIC_SITE_URL=https://redpoint-clinic.cz/

# Local Postgres from `pnpm db:up` (port 54340). Server-side only.
DATABASE_URL=postgres://booking:booking_dev_only@localhost:54340/booking
DATABASE_PREPARE=true
DATABASE_POOL_MAX=10

# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Staff auth: "dev" (local only, refused outside development) | "supabase"
AUTH_PROVIDER=dev
DEV_STAFF_PASSWORD=redpoint-dev
STAFF_REQUIRE_MFA=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "capture" stores mail in the DB (visible at /rezervace/dev/mailbox/ in development). Nothing is sent.
EMAIL_PROVIDER=capture
EMAIL_FROM="Redpoint Clinic <rezervace@example.invalid>"
SMTP_HOST=localhost
SMTP_PORT=54341
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REDIRECT_ALL_TO=

# Protects /api/rezervace/cron/outbox/ (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
