{
  "name": "@redcord/booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Redpoint Clinic booking (imported from the standalone redpoint-booking repo, commit 9fde9a9). Served by redcord-web under /rezervace/.",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "luxon": "3.7.2",
    "nodemailer": "7.0.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
