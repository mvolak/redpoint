{
  "name": "redcord-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Redcord.cz renewal — review prototype (concept for owner review, not a production service)",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "review": "node scripts/review-check.mjs http://localhost:3000",
    "images:harvest": "node scripts/harvest-images.mjs",
    "images:check": "node scripts/promote-images.mjs --check",
    "images:promote": "node scripts/promote-images.mjs",
    "inventory:old": "node scripts/page-inventory.mjs old",
    "inventory:new": "node scripts/page-inventory.mjs new",
    "inventory:compare": "node scripts/page-inventory.mjs compare"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
